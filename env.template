# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# ---- Alpaca (trading + market data) ----
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper endpoint by default. Only point this at the live endpoint after the
# Production Gate in memory/PROJECT-CONTEXT.md is fully checked off.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# ---- Perplexity (catalyst / research) ----
PERPLEXITY_API_KEY=
# Optional — defaults to "sonar" in scripts/perplexity.sh if unset.
PERPLEXITY_MODEL=sonar

# ---- ClickUp (task/notification log) ----
CLICKUP_API_KEY=
CLICKUP_LIST_ID=

# ---- Runtime mode ----
# paper | live  — hard-checked in quant/config.py; live requires
# require_production_gate: true in config/strategy.yaml to be satisfied.
TRADING_MODE=paper
